.dark-mode,
html.dark-mode-preload body { 
 --color-bg: #121212;
  --color-white: #1E1E1E;
  --color-text-dark: #F5F5F5;
  --color-text-gray: #A0A0B0;
  --color-border: #2A2A2A;

  --color-primary-light: #1F2A44;

  --card-blue-bg: #1C2A4A;
  --card-green-bg: #163A2A;
  --card-purple-bg: #2A1F3D;
  --card-yellow-bg: #3D2F14;

  --note-blue: #1C2A4A;
  --note-green: #163A2A;
  --note-purple: #2A1F3D;
  --note-red: #3D1E1E;

  background: #0A0A0A;
}
.dark-mode .toggle-slider {
  background: #4A4A55;
}
